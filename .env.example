# SkillBridge Deployment Environment Configuration

# Frontend Environment Variables (React + Vite)
# In local development: defaults to http://127.0.0.1:8000
# In production on Vercel: set to your deployed backend URL on Render (without trailing slash)
# Example: VITE_API_BASE_URL=https://skillbridge-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend Environment Variables (FastAPI + Uvicorn)
# Render automatically provides $PORT. For local override:
PORT=8000
