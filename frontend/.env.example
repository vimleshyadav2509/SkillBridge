# Frontend Environment Variables (React + Vite)
# Local development: defaults to http://127.0.0.1:8000
# Production on Vercel: defaults automatically to same-origin backend (e.g. https://skillbridge-delta-six.vercel.app)
# Optional dedicated external backend (e.g. Render):
# VITE_API_BASE_URL=https://skillbridge-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
